---
import KpiCard from './KpiCard.astro';
import type { PageDefinition } from '../data/pages';
const { page } = Astro.props as { page: PageDefinition };
---
<div class="notice">{page.description}</div>
<div class="grid g4">{page.kpis.map((k,i)=><KpiCard label={k[0]} value={k[1]} sub={k[2]} icon={['◉','✦','↗','☑'][i]} change={i===0?'Current demonstration state':'Demo-linked'} />)}</div>
<div class="split">
  <div class="panel"><div class="panel-head"><h2 class="panel-title">{page.primaryTitle}</h2><div class="context"><button class="pill" data-demo-action="Filters opened">Filters</button><button class="pill" data-demo-action="View changed">View ▾</button></div></div><div class="table-wrap" style="margin-top:10px"><table class="table"><thead><tr><th>Record</th><th>Context</th><th>Status</th><th>Updated</th></tr></thead><tbody>{page.primaryRows.map(r=><tr><td><button class="link" data-drawer-title={r[0]}>{r[0]}</button></td><td>{r[1]}</td><td><span class={`status ${r[2]==='Healthy'||r[2]==='Complete'?'green':r[2]==='Watch'?'orange':'blue'}`}>{r[2]}</span></td><td>{r[3]}</td></tr>)}</tbody></table></div></div>
  <div class="panel"><div class="panel-head"><h2 class="panel-title">{page.secondaryTitle}</h2><button class="link" data-drawer-title={page.secondaryTitle}>Open detail</button></div><div class="list" style="margin-top:12px">{page.secondaryItems.map(([label,value],i)=><button class="list-row" data-drawer-title={label} style="text-align:left"><div class="list-main"><div class="list-icon">{['✦','◉','↗','☑'][i%4]}</div><div><div class="row-title">{label}</div><div class="row-sub">Linked demonstration record</div></div></div><b>{value}</b></button>)}</div><div class="panel" style="box-shadow:none;margin-top:12px;background:rgba(111,76,255,.035)"><div class="panel-head"><h3 class="panel-title" style="font-size:14px">Operational Workflow</h3><button class="btn primary-btn" data-demo-action={`${page.title} demo action executed`}>Simulate action</button></div><div class="workflow" style="margin-top:10px"><div class="workflow-step"><span class="flow-num">1</span>Discover current state</div><div class="workflow-step"><span class="flow-num">2</span>Review linked records and evidence</div><div class="workflow-step"><span class="flow-num">3</span>Compare baseline or expected state</div><div class="workflow-step"><span class="flow-num">4</span>Take action or open investigation</div><div class="workflow-step"><span class="flow-num">5</span>Verify outcome and value</div></div></div></div>
</div>
