---
import KpiCard from './KpiCard.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const timeline=[['Humidity excursion','RH reached 72% for 23 minutes','High','Today, 6:42 AM'],['Canopy temperature anomaly','Hotspot detected in Zone 3','Medium','Yesterday, 2:17 PM'],['Intervention applied','Increased dehumidification','Action','Yesterday, 2:22 PM'],['Recovery observed','RH stabilised within target range','Recovered','Yesterday, 3:05 PM'],['Defoliation task completed','Lower canopy defoliation','Task','May 12, 10:09 AM']];
---
<div class="notice">Flower 04 · Batch B-260814-07 · Flower Week 6 · 486 plants</div>
<div class="grid g6">
  <KpiCard label="Crop State" value="Healthy" sub="No action required" icon="❋" change="Stable" />
  <KpiCard label="Environment" value="Optimal" sub="All targets in range" icon="☁" change="Stable" />
  <KpiCard label="Equipment" value="98%" sub="2 warnings" icon="⚙" change="Operational" />
  <KpiCard label="Forecast" value="On Track" sub="Harvest in 32 days" icon="↗" change="Positive" />
  <KpiCard label="Attention" value="2" sub="1 high · 1 medium" icon="△" change="Needs review" tone="warning" />
  <KpiCard label="System Data" value="100%" sub="All systems reporting" icon="☰" change="Linked" />
</div>
<div class="three">
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Live Cameras</h2><a class="link" href={`${base}cameras/`}>View all</a></div><div class="camera-grid" style="margin-top:12px">{['CAM-01','CAM-02','CAM-03','CAM-04'].map(c=><button class="camera" data-drawer-title={`${c} · Flower 04`}><span>{c} · LIVE</span></button>)}</div></div>
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Environmental Trends</h2><a class="link" href={`${base}environment/`}>Full trends</a></div><svg class="chart" viewBox="0 0 700 250" preserveAspectRatio="none"><g class="line-grid">{[40,80,120,160,200].map(y=><line x1="35" x2="675" y1={y} y2={y}/>)}</g><path d="M35 98 C95 80,135 110,180 92 S270 115,330 88 S420 100,480 83 S570 98,640 73" fill="none" stroke="#6f4cff" stroke-width="2.7"/><path d="M35 128 C95 140,135 119,180 131 S270 111,330 129 S420 116,480 126 S570 110,640 121" fill="none" stroke="#3b82f6" stroke-width="2.4"/><path d="M35 162 C95 150,135 164,180 158 S270 170,330 155 S420 166,480 154 S570 166,640 158" fill="none" stroke="#06b6d4" stroke-width="2.4"/><path d="M35 188 C95 184,135 193,180 187 S270 194,330 185 S420 195,480 184 S570 192,640 187" fill="none" stroke="#f59e0b" stroke-width="2.1"/></svg><div class="metric-grid"><div class="metric"><div class="metric-label">Temp</div><div class="metric-value">72.4°F</div></div><div class="metric"><div class="metric-label">RH</div><div class="metric-value">60%</div></div><div class="metric"><div class="metric-label">VPD</div><div class="metric-value">1.16</div></div><div class="metric"><div class="metric-label">CO₂</div><div class="metric-value">812</div></div><div class="metric"><div class="metric-label">PPFD</div><div class="metric-value">850</div></div></div></div>
  <div class="panel"><h2 class="panel-title">Room Status</h2><div class="metric-grid" style="margin-top:12px"><div class="metric"><div class="metric-label">Healthy</div><div class="metric-value positive">82%</div><div class="row-sub">398 plants</div></div><div class="metric"><div class="metric-label">Watch</div><div class="metric-value warning">12%</div><div class="row-sub">58 plants</div></div><div class="metric"><div class="metric-label">Attention</div><div class="metric-value danger">6%</div><div class="row-sub">30 plants</div></div></div><div class="list" style="margin-top:11px"><div class="list-row"><span class="row-title">Irrigation</span><span class="status green">On Schedule</span></div><div class="list-row"><span class="row-title">Growth stage</span><span>Flower Week 6</span></div><div class="list-row"><span class="row-title">Target harvest</span><span>Jun 15</span></div><div class="list-row"><span class="row-title">Recipe</span><span>Standard v2.1</span></div></div></div>
</div>
<div class="grid g3">
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Events Timeline</h2><a class="link" href={`${base}timeline/`}>View all</a></div><div class="timeline" style="margin-top:12px">{timeline.map(t=><button class="time-row" data-drawer-title={t[0]} style="border:0;background:transparent;text-align:left"><div class="dot"></div><div><div class="row-title">{t[0]}</div><div class="row-sub">{t[1]}</div></div><div><span class={`status ${t[2]==='High'?'red':t[2]==='Medium'?'orange':'blue'}`}>{t[2]}</span><div class="row-sub" style="margin-top:5px">{t[3]}</div></div></button>)}</div></div>
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Interventions</h2><a class="link" href={`${base}interventions/`}>View all</a></div><div class="list" style="margin-top:12px"><button class="metric" data-drawer-title="Increase Dehumidification" style="text-align:left"><div class="row-between"><div class="row-title">Increase Dehumidification</div><span class="status green">Active</span></div><div class="metric-grid" style="margin-top:9px"><div><div class="metric-label">Target RH</div><b>55%</b></div><div><div class="metric-label">Current</div><b>60%</b></div><div><div class="metric-label">Impact</div><b class="positive">Stabilising</b></div></div><div class="progress" style="margin-top:9px"><span style="width:65%"></span></div></button><button class="metric" data-drawer-title="Adjust Airflow Zone 3" style="text-align:left"><div class="row-between"><div class="row-title">Adjust Airflow Zone 3</div><span class="status green">Complete</span></div><div class="metric-grid" style="margin-top:9px"><div><div class="metric-label">Before</div><b>0.68 kPa</b></div><div><div class="metric-label">After</div><b>0.92 kPa</b></div><div><div class="metric-label">Impact</div><b class="positive">Improved</b></div></div></button></div></div>
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Comparison</h2><a class="link" href={`${base}comparisons/`}>Full comparison</a></div><div class="table-wrap"><table class="table"><tbody>{[['Avg Temp','72.4°F','+0.8°F'],['Avg RH','60%','-4%'],['Avg VPD','1.16 kPa','+0.08'],['Avg CO₂','812 ppm','+38'],['Avg PPFD','850','+25'],['Est. Yield','1.38 lb/ft²','+8%']].map(r=><tr><td><b>{r[0]}</b></td><td>{r[1]}</td><td class={r[2].includes('-')?'positive':r[0]==='Avg Temp'||r[0]==='Avg VPD'?'danger':'positive'}>{r[2]}</td></tr>)}</tbody></table></div></div>
</div>
<div class="grid g3">
  <div class="panel"><h2 class="panel-title">Room Map & Zones</h2><div class="map" style="margin-top:12px">{['Zone 1','Zone 2','Zone 3','Zone 4','Bench A','Bench B','Bench C','Bench D'].map(z=><button class="zone" data-drawer-title={z}>{z}</button>)}</div></div>
  <div class="panel"><div class="panel-head"><h2 class="panel-title">Equipment Status</h2><a class="link" href={`${base}equipment/`}>View all</a></div><div class="metric-grid" style="margin-top:12px">{[['HVAC','98%'],['Dehumidifier','95%'],['Irrigation','100%'],['Lighting','100%'],['CO₂ System','99%'],['Fans','97%']].map(e=><button class="metric" data-drawer-title={e[0]}><div class="metric-label">{e[0]}</div><div class="metric-value">{e[1]}</div><div class="small positive">Optimal</div></button>)}</div></div>
  <div class="panel"><h2 class="panel-title">Predicted Harvest</h2><div class="metric-grid" style="margin-top:12px"><div class="metric"><div class="metric-label">Predicted date</div><div class="row-title">Jun 15, 2024</div></div><div class="metric"><div class="metric-label">Days remaining</div><div class="metric-value">32</div></div><div class="metric"><div class="metric-label">Est. dry flower</div><div class="metric-value">1,420 lb</div></div></div><svg class="chart-short" viewBox="0 0 320 140" preserveAspectRatio="none"><path d="M15 112 C55 90,90 70,120 68 S180 70,220 66 S270 50,310 34 L310 125 L15 125 Z" fill="rgba(111,76,255,.1)"/><path d="M15 112 C55 90,90 70,120 68 S180 70,220 66 S270 50,310 34" fill="none" stroke="#6f4cff" stroke-width="3"/></svg></div>
</div>
